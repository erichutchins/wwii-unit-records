k","ref":"Attack 1","on_track":true,"local":"1944-11-22 2338 (K)","raw":"24-16N 122-28E","note":"Torpedo attack No. 1: 3 bow tubes (Mk 14-3A, 23, 23) at CHIDORI-type TB, range 800, fired by mistake at the tubes while gyros were matched by hand after a hot run in No. 4; all missed. Dove 2340; ten close depth charges from 2343","fix":"","page":"rg367-74848165/p26","scan":"https://catalog.archives.gov/medialz/microfilm-publications/M1752-US_SubWarPatrolReports_1941-194/M1752_00976-01000/images/0512.jpg"},{"boat":"shad","utc":"1944-11-24T00:26Z","lat":22.3333,"lon":126.55,"kind":"narrative","ref":"periscope","on_track":true,"local":"1944-11-24 1026 (K)","raw":"22-20N 126-33E","note":"Changed course to put lookout-reported periscope astern (typed 22° 20' N; 126° 33' E)","fix":"","page":"rg367-74848165/p11","scan":"https://catalog.archives.gov/medialz/microfilm-publications/M1752-US_SubWarPatrolReports_1941-194/M1752_00976-01000/images/0497.jpg"}]},"fixes":[{"boat":"bang","utc":"1944-11-22T12:25Z","lat":24.2667,"lon":122.5,"kind":"ship","ref":"Ship 2","on_track":false,"local":"1944-11-22 2225 (K)","raw":"24-16N 122-30E","note":"Convoy (1 large + 5 medium freighters; 3-4 escorts) 21000 yds; attacks 1-7","fix":"ship-contact positions are the target not BANG","page":"rg367-74802868/p09","scan":"https://catalog.archives.gov/medialz/microfilm-publications/M1752-US_SubWarPatrolReports_1941-194/M1752_00051-00075/images/0090.jpg"},{"boat":"bang","utc":"1944-11-22T14:32Z","lat":24.3917,"lon":122.6833,"kind":"attack","ref":"Attack 1","on_track":true,"local":"1944-11-23 0032 (K)","raw":"24-23.5N 122-41E","note":"Torpedo attack No. 1 (times not zoned; King per narrative)","fix":"","page":"rg367-74802868/p12","scan":"https://catalog.archives.gov/medialz/microfilm-publications/M1752-US_SubWarPatrolReports_1941-194/M1752_00051-00075/images/0093.jpg"},{"boat":"bang","utc":"1944-11-22T14:33Z","lat":24.3917,"lon":122.6833,"kind":"attack","ref":"Attack 2","on_track":true,"local":"1944-11-23