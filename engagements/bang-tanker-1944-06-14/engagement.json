2-US_SubWarPatrolReports_1941-194/M1752_00051-00075/images/0022.jpg","label":"p. 23","source_title":"National Archives","kind":"record","of":"us"}}],"events":[{"origin":"track","of":"us","actor":"bang","kind":"sighting","title":"Ship contact (1)","words":"Lone tanker 10000 yds; attack No. 1","local":"1944-06-14 0508 K","utc":"1944-06-13T19:08Z","key":"1944-06-13T19:08Z","cite":{"ref":"rg367-74802784/p14","href":"https://catalog.archives.gov/medialz/microfilm-publications/M1752-US_SubWarPatrolReports_1941-194/M1752_00051-00075/images/0013.jpg","label":"p. 14","source_title":"National Archives","kind":"record","of":"us"},"target":true,"lat":21.9167,"lon":142.7167,"opposed":false,"source_kind":"record","source_of":"us"},{"origin":"track","of":"us","actor":"bang","kind":"attack","title":"Attack 1","words":"Torpedo attack No. 1 (tanker)","local":"1944-06-14 1701 K","utc":"1944-06-14T07:01Z","key":"1944-06-14T07:01Z","lat":23.25,"lon":143.26,"cite":{"ref":"rg367-74802784/p23","href":"https://catalog.archives.gov/medialz/microfilm-publications/M1752-US_SubWarPatrolReports_1941-194/M1752_00051-00075/images/0022.jpg","label":"p. 23","source_title":"National Archives","kind":"record","of":"us"},"note":"","outcome":[],"opposed":false,"source_kind":"record","source_of":"us"}],"claims":[],"positions":[],"convoys":{},"sheets":{"bang":{"Attack 1":{"torpedoes":[{"date":"1944-06-14","time":"1701","zone":"K","tube":"1","own_course":"080","own_speed":"4.0","own_depth":"58","target_course":"044","target_speed":"10","target_range":"3600","target_draft":"14","track":"134P","gyro":"10R","depth_set":"9","power":"-","hit":"Miss","erratic":"No","torpedo":"23","since_first":"0","offset":"1.5R"},{"date":"1944-06-14","time":"1701","zone":"K","tube":"2","own_course":"080","own_speed":"4.0","own_depth":"58","target_course":"044","target_speed":"10","target_range":"3600","target_draft":"14","track":"136P","gyro":"8R","depth_set":"9","power":"High","hit":"Miss","erratic":"No","torpedo":"14-3A","since_first":"8","offset":"0"},{"date":"1944-06-14","time":"1701","zone":"K","tube":"3","own_course":"080","own_speed":"4.0","own_depth":"58","target_course":"044","target_speed":"10","target_range":"3600","target_draft":"14","track":"138P","gyro":"6R","depth_set":"9","power":"High","hit":"Hit","erratic":"No","torpedo":"14-3A","since_first":"16","offset":"1.5L"}],"words":[{"sheet":"1","type_attack":"Day periscope attack. Fired three torpedoes using 1½° between torpedoes applied from aft forward by means of the offset knob on TDC. Kept constant periscope bearings to TDC during firing.","description":"Empty tanker. Nearest estimate SYOYO MARU, page 286, ONI 208-J (revised), except he had a short heavy goal post between foremast and bridge structure. Estimate certain.","damaged":"One 7000-8000 ton AO.","determined_by":"Saw and heard one hit forward of stack. Saw target list and settle by stern, and put out life boats.","target_line":"Target Draft: 14' (light) Course: 044° Speed: 10 (At firing) Range: 3600","own_ship":"Speed: 4.0 Course: 080° Depth: 58' Angle: 0° (at firing)","sea":"Rough, force 4-5","overhaul":"U.S.S. PROTEUS","remarks":"Nine foot depth set because of rough sea conditions. Believe a shallower depth would have caused more damage on empty tanker.","page":"rg367-74802784/p23","table_page":"rg367-74802784/p24","note":"Gyro angles are typed relative to the bow (10R, 8R, 6R), not as true gyro angles as on the other sheets; with own course 080 and target course 044 they give the typed tracks (134P, 136P, 138P). Tube 1 (Mark 23) has power typed \"-\". The Mark 14-3A entries for tubes 2 and 3 are circled by hand on the scan. The longitude's last characters are cut off at the scan's edge (143°-15.6E in positions.csv)."}],"cite":{"ref":"rg367-74802784/p23","href":"https://catalog.archives.gov/medialz/microfilm-publications/M1752-US_SubWarPatrolReports_1941-194/M1752_00051-00075/images/0022.jpg","label":"p. 23","source_title":"National Archives","kind":"record","of":"us"}}}}}
